# ------------------------------------------------------------------
# Amen backend environment (SERVER-SIDE ONLY — never shipped to the frontend)
# Copy to backend/.env and fill in real values. backend/.env is gitignored.
# ------------------------------------------------------------------

# --- SportyBet public share endpoint (no API key required) ---
SPORTYBET_BASE_URL=https://www.sportybet.com
SPORTYBET_SHARE_PATH=/api/ng/orders/share
SPORTYBET_TIMEOUT=20

# --- Forebet ---
FOREBET_BASE_URL=https://www.forebet.com
FOREBET_TIMEOUT=20
FOREBET_USER_AGENT=Mozilla/5.0 (compatible; Amen Forebet Analyzer/1.0)

# --- Telegram (BACKEND ONLY) ---
# Bot token from @BotFather. NEVER expose this to the frontend, logs, or API
# responses. It is used only to validate signed initData and to run the bot.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the deployed Mini App (the built frontend). Used by the
# bot for the /start button and the chat menu button. Do NOT hardcode localhost
# for production — set this to your real deployed URL.
TELEGRAM_WEBAPP_URL=
# How long a signed initData payload stays valid, in seconds (default 24h).
TELEGRAM_AUTH_MAX_AGE=86400

# Persistent production database. Use PostgreSQL in deployed environments.
# Example shape only; never commit real credentials:
# DATABASE_URL=postgresql://user:password@host:5432/database
# If omitted, local development falls back to HISTORY_DATABASE_PATH SQLite.
DATABASE_URL=
HISTORY_DATABASE_PATH=amen_history.sqlite3

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
